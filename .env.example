# Shopify
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=beauticate.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_public_token
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=your_private_token

# Shopify Admin API + gift-with-purchase webhook (server-only — never client-side)
# Custom app Admin API access token. Required scopes: read_orders, write_orders
SHOPIFY_ADMIN_API_TOKEN=shpat_xxx
# The webhook signing secret used to verify X-Shopify-Hmac-Sha256.
# = your custom app's "API secret key" (or the per-subscription secret if you
#   register webhooks via the Admin API).
SHOPIFY_WEBHOOK_SECRET=your_webhook_signing_secret

# Gift-with-purchase email provider — set ONE (Resend recommended). NOT Klaviyo.
# From/BCC addresses are configured in lib/gift-campaign.ts and must be verified senders.
RESEND_API_KEY=re_xxx
# POSTMARK_SERVER_TOKEN=your_postmark_server_token

# Optional but recommended: Vercel KV / Upstash Redis for race-free webhook dedup.
# Without these, dedup still works via the order's gift-processed tag (covers
# Shopify's normal spaced retries); these close the rare simultaneous-duplicate race.
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx

# Vercel Blob — stores per-brand gift state (the "claimed" flag phase two reads).
# Auto-populated when you add a Blob store to the project; set locally to test state writes.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Klaviyo
KLAVIYO_API_KEY=your_klaviyo_api_key_here
NEXT_PUBLIC_KLAVIYO_LIST_ID=your_list_id_here

# Stamped.io
STAMPED_API_KEY=your_stamped_api_key_here
STAMPED_STORE_HASH=your_store_hash_here

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=your_pixel_id_here

# Site
NEXT_PUBLIC_SITE_URL=https://www.beauticate.com
