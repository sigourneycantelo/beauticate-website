//         link.setAttribute("rel", "noopener noreferrer");
//       }
//     });
//   }
// });
// 


document.addEventListener("DOMContentLoaded", function () {
  document.querySelectorAll('a[href^="http"]').forEach(function (link) {
    const url = new URL(link.href);

    if (url.hostname !== location.hostname) {
      link.setAttribute("target", "_blank");
      link.setAttribute("rel", "noopener noreferrer");
    }
  });
});
</script><script>(function () {
    function initMegaMenuImages() {
        console.log('Attempting to initialize mega menus...');
        
        // Find ALL mega menu containers
        const menus = document.querySelectorAll('.mega-menu-cat-items');
        console.log('Menus found:', menus.length);
        
        if (!menus.length) return false;
        
        let initialized = false;
        
        // Initialize each menu separately
        menus.forEach((menu, menuIndex) => {
            console.log(`Initializing menu ${menuIndex + 1}`);
            
            const items = menu.querySelectorAll('.menu-category-item');
            console.log(`Menu ${menuIndex + 1} - Items found:`, items.length);
            
            if (!items.length) return;
            
            const firstItem = items[0];
            const firstImg = firstItem.querySelector('.menu-category-post-img');
            
            if (!firstImg) return;
            
            // Reset all images in this menu and remove active-cat-img class
            items.forEach(item => {
                const img = item.querySelector('.menu-category-post-img');
                if (img) {
                    img.style.opacity = '0';
                    img.classList.remove('active-cat-img');
                }
            });
            
            // Add active-cat-img class and show first image
            firstImg.classList.add('active-cat-img');
            firstImg.style.opacity = '1';
            console.log(`Menu ${menuIndex + 1} - Active class added:`, firstImg.classList.contains('active-cat-img'));
            
            // Add event listeners for this menu's items
            items.forEach(item => {
                const img = item.querySelector('.menu-category-post-img');
                if (!img) return;
                
                item.addEventListener('mouseenter', () => {
                    // Remove active-cat-img class from all images in THIS menu
                    items.forEach(i => {
                        const iImg = i.querySelector('.menu-category-post-img');
                        if (iImg) {
                            iImg.classList.remove('active-cat-img');
                            iImg.style.opacity = '0';
                        }
                    });
                    // Add active-cat-img class to current image
                    img.classList.add('active-cat-img');
                    img.style.opacity = '1';
                });
                
                item.addEventListener('mouseleave', () => {
                    // Remove active-cat-img class from all images in THIS menu
                    items.forEach(i => {
                        const iImg = i.querySelector('.menu-category-post-img');
                        if (iImg) {
                            iImg.classList.remove('active-cat-img');
                            iImg.style.opacity = '0';
                        }
                    });
                    // Add active-cat-img class back to first image
                    firstImg.classList.add('active-cat-img');
                    firstImg.style.opacity = '1';
                });
            });
            
            initialized = true;
        });
        
        return initialized;
    }
    
    // Try on DOMContentLoaded
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMegaMenuImages);
    } else {
        // DOM already loaded, try immediately
        if (initMegaMenuImages()) {
            console.log('Initialized successfully on load');
            return;
        }
    }
    
    // Observe DOM for late-loaded menus
    const observer = new MutationObserver(() => {
        if (initMegaMenuImages()) {
            console.log('Initialized successfully via observer');
            observer.disconnect();
        }
    });
    
    observer.observe(document.body, {
        childList: true,
        subtree: true
    });
})();</script><script>document.addEventListener("DOMContentLoaded", function () {
  const stickyHeader = document.querySelector(".sticky-header");
  if (!stickyHeader) return;

  window.addEventListener("scroll", function () {
    if (window.scrollY > 400) {
      document.body.classList.add("show-sticky-header");
    } else {
      document.body.classList.remove("show-sticky-header");
    }
  });
});</script><link rel="icon" href="https://www.beauticate.com/wp-content/uploads/2018/05/cropped-favicon-100x100.png" sizes="32x32" />
