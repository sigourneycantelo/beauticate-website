/* Start Search btn css desktop */
.menu-primary .astm-search-menu {
    display: flex;
    align-items: center;
    position: relative;
}

/* Hidden state */
.menu-primary .is-search-input {
    width: 220px;
    height: 38px;
    padding: 0 14px;
    border-radius: 20px;
    border: 1px solid #ddd;
    background: #fff;

    transform: scaleX(0);
    transform-origin: right;
    opacity: 0;

    transition:
        transform 0.35s ease,
        opacity 0.25s ease;
}

/* Open on hover / focus */
.menu-primary .astm-search-menu:hover .is-search-input,
.menu-primary .is-search-input:focus {
    transform: scaleX(1);
    opacity: 1;
}

/* End Search btn css desktop */

@media screen and (min-width: 460px) {
.menu-category-post-img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
}

.menu-category-post-img .menu-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: opacity 0.35s ease;
}

.menu-category-post-img .menu-img.hover {
    opacity: 0;
}

.menu-category-post-img:hover .menu-img.hover {
    opacity: 1;
}

.menu-category-post-img:hover .menu-img.main {
    opacity: 0;
}

.mega-sub-menu .mega-menu-cat-items .menu-category-post-img
 {
    top: 50px !important;
	  right: 50px !important;
}

.mega-living-submenu .menu-category-name {
    margin-bottom: -25px !important;
}

#mega-menu-wrap-beauticate-main-menu #mega-menu-beauticate-main-menu li.mega-menu-megamenu>ul.mega-sub-menu>li.mega-menu-row .mega-menu-column {
    min-height: 300px !important;
}

.mega-wellness-submenu .menu-category-name, .mega-beauty-submenu .menu-category-name {
    margin-bottom: -25px !important;
}

.mega-sub-menu .mega-menu-cat-items.mega-beauty-submenu .menu-category-post-img
 {
    top: 25px !important;
    width: 375px !important;
}

.mega-beauty-submenu .mega-sub-menu {
    padding: 0px !important;
    margin-left: -50px !important;
    margin-top: -30px !important;
}

.travel-items {
	width: 25% !important;
	margin-top: 15px !important;
}
.beauty-wellness-items {
	width: 75% !important;
}
.menu-category-post-img {
    opacity: 0;
    transition: opacity 0.35s ease;
}
.menu-category-item.is-default .menu-category-post-img {
    opacity: 1;
}
.mega-sub-menu .mega-menu-cat-items .menu-category-post-img.active-cat-img {
	opacity: 1;
	visibility: visible;
}
}

/* Best 50 product page css start */

.top-50-head h2 {
    font-family: "Century Gothic", Sans-serif !important;
}

.shop-edit h2 {
	font-family: "Antro Vectra", Sans-serif !important;
}

.top-counts h2 {
	font-family: "The Season", Sans-serif !important;
	font-weight: 400 !important;
}

.sacred-form .elementor-form .elementor-button.elementor-size-md {
    min-height: 45px;
}

.page-id-78895 p {
	color: #000 !important;
	font-size: 20px !important;
}

.the-guide #form-field-email, .the-guide button.elementor-button.elementor-size-md {
    font-family: "Century Gothic", sans-serif !important;
}
.code-text p {
    font-size: 14px;
    color: #5a4135 !important;
    font-weight: 700;
}

/* Best 50 product page css end */

a.home-grid-title {
    font-family: CenturyGothic !important;
    font-size: 32px !important;
    line-height: 34px;
    text-transform: uppercase;
    margin-top: 10px !important;
}

a.home-grid-title:hover {
    color: #B26C56;
}
</style>
