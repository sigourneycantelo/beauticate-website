{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://www.beauticate.com"
  },
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://beauticate.com/shop",
      "permanent": true,
      "has": [{ "type": "host", "value": "shop.beauticate.com" }]
    },
    {
      "source": "/:path*",
      "destination": "https://beauticate.com/shop",
      "permanent": true,
      "has": [{ "type": "host", "value": "beauticate.shop" }]
    },
    {
      "source": "/destinations/spas-retreats/melanie-grant-skin-health-double-bay",
      "destination": "/destinations/clinics/melanie-grant-skin-health-double-bay",
      "permanent": true
    },
    {
      "source": "/destinations/spas-retreats/the-girl-you-love-glebe",
      "destination": "/destinations/clinics/the-girl-you-love-glebe",
      "permanent": true
    }
  ]
}
